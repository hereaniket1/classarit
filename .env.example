# Copy to .env for local use. Never commit real credentials.
# Google, PostgreSQL, Resend and email OTP are used by the current app.

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=''

# PostgreSQL database and schema are separate settings.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=classarit
DB_SCHEMA="classarit"
DB_USER=''
DB_PASSWORD=''
# For hosted PostgreSQL use the TLS mode required by your provider.
DB_SSLMODE=require

# Resend uses an API key, not a client ID.
RESEND_API_KEY=''
# Must be an address on your verified Resend domain. Example: Classarit <noreply@yourdomain.com>.
# Resend rejects placeholder domains such as example.com.
RESEND_FROM_EMAIL="Classarit <noreply@yourdomain.com>"

# Optional shared session key; if empty, a private key is generated in the data directory.
# Use a separate random value for hashing email OTP challenges.
SESSION_SECRET_KEY=''
OTP_HMAC_SECRET=''
